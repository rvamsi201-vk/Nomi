generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id         String      @id @default(cuid())
  name       String
  slug       String      @unique
  createdAt  DateTime    @default(now())
  members    OrgMember[]
  channels   Channel[]
  projects   Project[]
  docFolders DocFolder[]
  timeEntries TimeEntry[]
}

model OrgMember {
  orgId  String
  userId String
  role   String // admin | member
  org    Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user   User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([orgId, userId])
}

model User {
  id                 String           @id @default(cuid())
  name               String
  email              String           @unique
  passwordHash       String
  lastSeenAt         DateTime?
  createdAt          DateTime         @default(now())
  orgMemberships     OrgMember[]
  memberships        ChannelMember[]
  messages           Message[]
  projects           Project[]        @relation("ProjectOwner")
  projectMemberships ProjectMember[]
  assignedTasks      Task[]           @relation("TaskAssignee")
  channelKnowledge   ChannelKnowledge[]
  stickyNotes        StickyNote[]
  weeklyGoals        WeeklyGoal[]
  ownedDocFolders    DocFolder[]       @relation("DocFolderOwner")
  docFolderMemberships DocFolderMember[]
  uploadedDocFiles   DocFile[]
  timeEntries        TimeEntry[]
}

model Channel {
  id             String             @id @default(cuid())
  organizationId String
  name           String
  slug           String
  type           String             @default("public") // public | private | dm
  createdAt      DateTime           @default(now())
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  members        ChannelMember[]
  messages       Message[]
  knowledge      ChannelKnowledge[]
  project        Project?

  @@unique([organizationId, slug])
}

model ChannelMember {
  channelId  String
  userId     String
  lastReadAt DateTime?
  channel    Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  user       User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([channelId, userId])
}

model Message {
  id        String   @id @default(cuid())
  channelId String
  userId    String
  text      String   @default("")
  fileName  String?
  filePath  String?
  mimeType  String?
  sizeBytes Int?
  createdAt DateTime @default(now())
  channel   Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([channelId, createdAt])
}

model ChannelKnowledge {
  id        String   @id @default(cuid())
  channelId String
  userId    String
  kind      String
  title     String
  body      String   @default("")
  fileName  String?
  filePath  String?
  mimeType  String?
  sizeBytes Int?
  createdAt DateTime @default(now())
  channel   Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([channelId, createdAt])
}

model Project {
  id             String          @id @default(cuid())
  organizationId String
  name           String
  slug           String
  description    String          @default("")
  visibility     String          @default("public") // public | private
  channelId      String?         @unique
  ownerId        String
  createdAt      DateTime        @default(now())
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  owner          User            @relation("ProjectOwner", fields: [ownerId], references: [id])
  channel        Channel?        @relation(fields: [channelId], references: [id])
  members        ProjectMember[]
  tasks          Task[]
  weeklyGoals    WeeklyGoal[]

  @@unique([organizationId, slug])
}

model ProjectMember {
  projectId String
  userId    String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([projectId, userId])
}

model Task {
  id              String   @id @default(cuid())
  projectId       String
  title           String
  status          String   @default("todo")
  assigneeId      String?
  createdById     String?
  createdAt       DateTime @default(now())
  statusUpdatedAt DateTime @default(now())
  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignee        User?    @relation("TaskAssignee", fields: [assigneeId], references: [id])
  weeklyGoals     WeeklyGoal[]
}

model WeeklyGoal {
  id        String  @id @default(cuid())
  projectId String
  userId    String
  weekStart String // Monday YYYY-MM-DD
  dayIndex  Int // 0=Mon ... 6=Sun
  taskId    String?
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  task      Task?   @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@unique([projectId, userId, weekStart, dayIndex])
  @@index([projectId, weekStart])
}

model StickyNote {
  id        String   @id @default(cuid())
  userId    String
  dateKey   String // YYYY-MM-DD
  body      String   @default("")
  color     String   @default("butter")
  x         Float    @default(40)
  y         Float    @default(40)
  width     Float    @default(210)
  height    Float    @default(190)
  zIndex    Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, dateKey])
}

model DocFolder {
  id             String            @id @default(cuid())
  organizationId String
  name           String
  slug           String
  description    String            @default("")
  ownerId        String
  parentId       String?
  createdAt      DateTime          @default(now())
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  owner          User              @relation("DocFolderOwner", fields: [ownerId], references: [id])
  parent         DocFolder?        @relation("DocFolderTree", fields: [parentId], references: [id], onDelete: Cascade)
  children       DocFolder[]       @relation("DocFolderTree")
  members        DocFolderMember[]
  files          DocFile[]

  @@unique([organizationId, slug])
  @@index([parentId])
}

model DocFolderMember {
  folderId String
  userId   String
  folder   DocFolder @relation(fields: [folderId], references: [id], onDelete: Cascade)
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([folderId, userId])
}

model DocFile {
  id        String    @id @default(cuid())
  folderId  String
  userId    String
  fileName  String
  filePath  String
  mimeType  String    @default("application/octet-stream")
  sizeBytes Int
  createdAt DateTime  @default(now())
  folder    DocFolder @relation(fields: [folderId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([folderId, createdAt])
}

model TimeEntry {
  id             String       @id @default(cuid())
  organizationId String
  userId         String
  work           String
  startedAt      DateTime
  endedAt        DateTime?
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId, userId, startedAt])
  @@index([userId, endedAt])
}
